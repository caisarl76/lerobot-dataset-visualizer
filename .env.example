# Optional backend validation override; it must remain loopback.
# CURATION_BACKEND_HOST defaults to 127.0.0.1.

# External runtime configuration must provide the following variable names.
# Deliberately do not assign values here:
# CURATION_BEARER_TOKEN
# COSMOS_BASE_URL
# COSMOS_MODEL
# COSMOS_API_KEY_ENV
# COSMOS_ENDPOINT_IDENTITY
# The variable named by COSMOS_API_KEY_ENV is also external and secret.

# Security boundary: do not expose any curation token, API key, Cosmos setting,
# or endpoint identity through a NEXT_PUBLIC_* variable.

# Legacy v3.1 annotation configuration (not used by task_index curation):
# DATASET_URL defaults to https://huggingface.co/datasets
