# Optional backend validation override; it must remain loopback.
# CURATION_BACKEND_HOST defaults to 127.0.0.1.

# External runtime configuration must provide the following variable names.
# Deliberately do not assign values here:
# CURATION_BEARER_TOKEN
# COSMOS_BASE_URL
# COSMOS_MODEL
# COSMOS_API_KEY_ENV
# COSMOS_ENDPOINT_IDENTITY
# The variable named by COSMOS_API_KEY_ENV is also external and secret.
# Use a distinct target such as COSMOS_API_KEY; it may not collide with
# inherited process names, CURATION_*/NEXT_PUBLIC_*, or named Cosmos/Isaac settings.
# APPROVED_CURATION_COMMIT_SHA is an independently reviewed full commit SHA
# entered shell-locally for checkout preflight; never derive it from live HEAD.

# Security boundary: do not expose any curation token, API key, Cosmos setting,
# or endpoint identity through a NEXT_PUBLIC_* variable.

# Legacy v3.1 annotation configuration (not used by task_index curation):
# DATASET_URL defaults to https://huggingface.co/datasets
# NEXT_PUBLIC_ANNOTATE_BACKEND_URL is optional for the legacy annotation tab

# Hosted official annotation workflow (private Space only).
# Space build variable: NEXT_PUBLIC_ANNOTATE_BACKEND_URL=/api/annotation
# Runtime variables: ANNOTATION_BROWSER_ORIGIN=https://<space-host>.hf.space
# ANNOTATION_BACKEND_URL=https://<annotation-host>
# ANNOTATION_HOSTED_PRIVATE_SPACE=1 only after configuring the Space private.
# Secret: ANNOTATION_BACKEND_TOKEN (same value on Space and H100 backend).
# H100 only: ANNOTATION_HUB_REPOS=mncai/G1_Dex3_Trash_LocoManipulation
# H100 only secrets: HF_TOKEN, LEROBOT_VLM_API_KEY.
# Never put server credentials in NEXT_PUBLIC variables.

# Combined private Space with hosted Genon Qwen (root Dockerfile):
# Secrets: GENON_API_KEY, HF_TOKEN
# ANNOTATION_VLM_API_BASE=<confirmed Genon HTTPS OpenAI-compatible base URL>
# ANNOTATION_WORKSPACE=<persistent mounted workspace path>
# ANNOTATION_HOSTED_PRIVATE_SPACE=1 after verifying private visibility
# ANNOTATION_HUB_REPOS=mncai/G1_Dex3_PickAndPlaceTrash
# SPACE_HOST is supplied by Hugging Face; backend URL/token are internal at boot.
